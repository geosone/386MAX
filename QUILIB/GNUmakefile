# LQUILIBR.LIB, the user interface library of ASQ, MAXIMIZE and INSTALL,
# large model, and QLOGO.OVL (GNU make, see linux/mk/dos.mk).  Microsoft C 7 is replaced by OpenWatcom.
PROJ     := QUILIB
ROOT     := $(abspath ..)
SRCDIRS  := .
ASMINC   := . ../INCLUDE ../INC ../386MAX
CASEMAP  := mx
CMODEL   := l
DEFS     := MODEL=LARGE C700
CDEFS    := DOS_VERSION
LIBS     := LQUILIBR.LIB
PROGS    := QLOGO.OVL

LQUILIBR.LIB_OBJS := ARGSTR.OBJ BCD_NUM.OBJ BIOSCRC.OBJ BLIST.OBJ BOOTDRV.OBJ BOX.OBJ \
	BUTTON.OBJ CHKABORT.OBJ COLORS.OBJ COPYFILE.OBJ CPU.OBJ CRITERR.OBJ \
	C_TLOAD.OBJ CURSOR1.OBJ CURSOR2.OBJ CURSOR.OBJ DATESTR.OBJ DCACHE.OBJ \
	DIALOG.OBJ DMALLOC.OBJ DPMI_CRC.OBJ EDITWIN.OBJ EMSINFO.OBJ ERROR.OBJ \
	EXENAME.OBJ EXTSIZE.OBJ FILEDIFF.OBJ FILEEDIT.OBJ FILENAME.OBJ \
	FLDEDIT.OBJ GAMEPORT.OBJ HELPBACK.OBJ INPUT.OBJ INSHELP.OBJ \
	INST2324.OBJ INT9HOOK.OBJ INTMSG.OBJ JUSTSTR.OBJ KEYBID.OBJ \
	KEYBOARD.OBJ LAUNDER.OBJ LOGO.OBJ MBOOT.OBJ MBOOTSEL.OBJ MBPARSE.OBJ \
	MCA_POS.OBJ MENU.OBJ MESSAGE.OBJ MOUSE.OBJ MYALLOC.OBJ NOMEM.OBJ \
	OPTION.OBJ OWNER.OBJ POS_TEST.OBJ PRERROR.OBJ PRINT.OBJ QHELP.OBJ \
	QMAXPRES.OBJ RAMSCAN.OBJ READPROF.OBJ SAVEADF.OBJ SERIAL.OBJ SLEEP.OBJ \
	SSTOR.OBJ STACKDLG.OBJ STACKER.OBJ SVGA_INF.OBJ TEXTCUR.OBJ TEXTWIN.OBJ \
	TRIM.OBJ TRNBLN.OBJ TRUENAME.OBJ UI.OBJ VCPI_CRC.OBJ VENDINFO.OBJ \
	VIDEOID.OBJ VIDEO.OBJ WAIT.OBJ WINDOWFN.OBJ WINSVRS.OBJ WINVER.OBJ \
	WORDSET.OBJ WRAPSTR.OBJ SETUPINF.OBJ

QLOGO.OVL_OBJS := QLOGO.OBJ
QLOGO.OVL_COM  := 1


include $(ROOT)/linux/mk/dos.mk

# Windows variant of the functions the Windows programs use
all: quiwin
quiwin: $(OUT)/LQUILIBR.LIB
	$(MAKE) -f quiwin.mk
clean: quiwin-clean
quiwin-clean:
	$(MAKE) -f quiwin.mk clean
.PHONY: quiwin quiwin-clean
