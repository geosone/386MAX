# MAXIMIZE.EXE (GNU make, see linux/mk/dos.mk).  Microsoft C is replaced by OpenWatcom, the .PRO prototype
# files ("cl /Zg") are made by linux/tools/protogen.py.  WRCONFIG.C and
# WRFILES3.C were missing from the tree and are reconstructed from REB/.
PROJ     := MAXIMIZE
ROOT     := $(abspath ..)
SRCDIRS  := . ../386MAX
ASMINC   := . ../INCLUDE ../INC ../386MAX ../QUILIB
CASEMAP  := mx
CMODEL   := l
DEFS     := MODEL=LARGE ASYS=0 BETA=0
CDEFS    := SYSTEM=MAX REORDER
PRODEFS  := PROTO CVDBG
PROGS    := MAXIMIZE.EXE

MAXIMIZE.EXE_OBJS := BROWSE.OBJ CHKRAM.OBJ COPYFILE.OBJ \
	INS_ADF.OBJ INS_ADP.OBJ INS_EMS.OBJ INS_EXE.OBJ INS_MAP.OBJ INS_MCA.OBJ \
	INS_OPT.OBJ INS_POS.OBJ P1BROWSE.OBJ \
	LINKLIST.OBJ MAXIMIZE.OBJ MAXSUB.OBJ MXPRINT.OBJ P3UPDATE.OBJ \
	PARSE.OBJ PASS1.OBJ PASS2.OBJ PASS3.OBJ PROCCFG1.OBJ PROFILE.OBJ \
	READCNFG.OBJ READMXMZ.OBJ REBOOT.OBJ REORDER.OBJ SCREENS.OBJ UTIL.OBJ \
	UTIL_MAC.OBJ UTIL_OPT.OPT UTIL_USE.OBJ WRCONFIG.OBJ WRFILES3.OBJ \
	VERSDATA.OBJ VERSRET.OBJ VERSBETA.OBJ SHDMAP.OBJ ZZTAIL.OBJ
MAXIMIZE.EXE_LIBS  := $(ROOT)/build/QUILIB/LQUILIBR.LIB $(ROOT)/build/HELPENG/LHELP.LIB
MAXIMIZE.EXE_STACK := 8192

# the end-of-program marker is the one of ASQ
ZZTAIL.OBJ_SRC := $(ROOT)/ASQ/ZZTAIL.ASM

PROS := BROWSE.PRO CHKRAM.PRO COPYFILE.PRO \
	INS_ADF.PRO INS_EMS.PRO INS_EXE.PRO INS_MAP.PRO INS_MCA.PRO INS_OPT.PRO \
	P1BROWSE.PRO LINKLIST.PRO MAXIMIZE.PRO P3UPDATE.PRO PARSE.PRO PASS1.PRO \
	PASS2.PRO PASS3.PRO PROCCFG1.PRO PROFILE.PRO READCNFG.PRO READMXMZ.PRO \
	REBOOT.PRO REORDER.PRO SCREENS.PRO UTIL.PRO WRCONFIG.PRO WRFILES3.PRO


include $(ROOT)/linux/mk/dos.mk
