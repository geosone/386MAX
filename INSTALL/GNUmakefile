# SETUPDOS.EXE, the DOS installer (GNU make, see linux/mk/dos.mk; MAKEFILE
# is the original NMAKE file, which built MAXIB\MAXIB.EXE).  Microsoft C is
# replaced by OpenWatcom; PKWARE's IMPLODE.LIB and TEXT/CRC32.OBJ by
# EXPLODE.C.  The archives are made by linux/tools/qpack.py.
PROJ     := INSTALL
ROOT     := $(abspath ..)
SRCDIRS  := . ../MAXIMIZE ../ASQENG ../386MAX ../ASQ
ASMINC   := . ../INCLUDE ../INC ../386MAX ../MAXIMIZE ../QUILIB
CASEMAP  := mx
CMODEL   := l
DEFS     := MODEL=LARGE BETA=0 ASYS=0 C700
CDEFS    := MAXIB
PRODEFS  := PROTO CVDBG UPDATE=1 REDUIT=1 WINDOWS30=1
PROGS    := SETUPDOS.EXE

SETUPDOS.EXE_OBJS := DRVE.OBJ FILES.OBJ INPRINT.OBJ INSTALL.OBJ MISC.OBJ SCRN.OBJ \
	SECURITY.OBJ SERIALNO.OBJ PD_SUB.OBJ VERSDATA.OBJ VERSRET.OBJ EXPLODE.OBJ \
	MULTIME.OBJ VERSBETA.OBJ INS_POS.OBJ MXZ_ADF.OBJ ZZTAIL.OBJ
SETUPDOS.EXE_LIBS  := $(ROOT)/build/QUILIB/LQUILIBR.LIB $(ROOT)/build/HELPENG/LHELP.LIB \
	$(ROOT)/build/VERLIB/VERL.LIB
SETUPDOS.EXE_STACK := 8192

PROS := DRVE.PRO FILES.PRO INPRINT.PRO INSTALL.PRO MISC.PRO SCRN.PRO \
	SECURITY.PRO SERIALNO.PRO MXZ_ADF.PRO EXPLODE.PRO INS_ADF.PRO

# no original objects of the C build in the tree
NOORIGOBJ := 1

include $(ROOT)/linux/mk/dos.mk
