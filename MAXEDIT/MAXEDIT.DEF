; module-definition file for MAXEDIT (wxWindows 1.68E, Open 386MAX 9)
; no CODE line: wlink packs the code segments only without one

NAME	     MAXEDIT

DESCRIPTION  'MAXedit, Open 386MAX'

EXETYPE      WINDOWS

DATA	     PRELOAD MOVEABLE MULTIPLE

HEAPSIZE     8192
STACKSIZE    16384

