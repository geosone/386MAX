	LTEXT			"Open 386MAX 2022-2026, GNU GPL v3", -1, 42, 31, 155, 10, SS_NOPREFIX

	LTEXT			"Welcome to " MAX8PRODUCT "  - the Intelligent Memory Manager for Windows 95, Windows 3.1x and DOS."
