+/* set the segment's class. report an error if the class has been set
+ * already and the new value differs. */
+
+static ret_code SetSegmentClass( struct dsym *seg, const char *name )
+/*******************************************************************/
+{
+    struct asym *clsym;
+
+    clsym = CreateClassLname( name );
+    if( clsym == NULL ) {
