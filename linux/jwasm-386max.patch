+/* 386MAX: Masm 5.1 sizes a branch by whether its destination was known in
+ * pass one. The branches are counted in every pass; those with a forward
+ * reference in pass one are marked. */
+static uint_32 m510_brno;
+static uint_8 *m510_fwd;
+static uint_32 m510_fwdsize;
+
+void m510_BranchPassInit( void )
+{
+    m510_brno = 0;
+    if ( Parse_Pass == PASS_1 && m510_fwd )
+        memset( m510_fwd, 0, m510_fwdsize );
+}
+
+static void m510_mark( uint_32 n )
+{
+    if ( n / 8 >= m510_fwdsize ) {
+        uint_32 newsize = ( n / 8 + 1 ) * 2;
+        uint_8 *p = calloc( newsize, 1 );
+        if ( p == NULL )
+            return;
+        if ( m510_fwd ) {
+            memcpy( p, m510_fwd, m510_fwdsize );
+            free( m510_fwd );
+        }
+        m510_fwd = p;
+        m510_fwdsize = newsize;
+    }
+    m510_fwd[n / 8] |= 1 << ( n % 8 );
+}
+
+static int m510_isfwd( uint_32 n )
+{
+    return( n / 8 < m510_fwdsize && ( m510_fwd[n / 8] & ( 1 << ( n % 8 ) ) ) );
+}
