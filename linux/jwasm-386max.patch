+/* find token in a string table */
+
+static int FindToken( const char *token, const char * const *table, int size )
+/****************************************************************************/
+{
+    int i;
+    for( i = 0; i < size; i++, table++ ) {
+        if( _stricmp( *table, token ) == 0 ) {
+            return( i );
+        }
+    }
+    return( -1 );  /* Not found */
+}
