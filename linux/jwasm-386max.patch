+
+/* 386MAX: Masm 5.1 replaces a structure by a different redefinition. The
+ * versions are kept in the order of pass one; in later passes each STRUC
+ * of the name switches the symbol to its next version. */
+struct m510_sver {
+    struct m510_sver   *next;
+    struct dsym        *sym;       /* the structure symbol */
+    int                idx;        /* version number */
+    struct struct_info *si;
+    uint_32            total_size;
+    uint_32            total_length;
+    uint_32            max_mbr_size;
+    enum memtype       mem_type;
+};
+static struct m510_sver *m510_svers;
+static struct dsym *m510_svsym;    /* versions used in this pass */
+static int m510_svpass, m510_svcnt[64];
+
+static void m510_sv_add( struct dsym *sym, int idx, struct struct_info *si, struct asym *from )
+{
+    struct m510_sver *v = LclAlloc( sizeof( struct m510_sver ) );
+    v->sym = sym; v->idx = idx; v->si = si;
+    v->total_size = from->total_size; v->total_length = from->total_length;
+    v->max_mbr_size = from->max_mbr_size; v->mem_type = from->mem_type;
+    v->next = m510_svers;
+    m510_svers = v;
+}
+
+static int m510_sv_count( struct dsym *sym )
+{
+    struct m510_sver *v;
+    int n = 0;
+    for ( v = m510_svers; v; v = v->next )
+        if ( v->sym == sym ) n++;
+    return( n );
+}
+
+/* in pass > 1: switch sym to the version of this STRUC */
+static void m510_sv_select( struct dsym *sym )
+{
+    struct m510_sver *v;
+    int slot = 0, k;
+    if ( m510_svpass != Parse_Pass ) {
+        m510_svpass = Parse_Pass;
+        memset( m510_svcnt, 0, sizeof( m510_svcnt ) );
+    }
+    /* the slot of a symbol: its position among the symbols with versions */
+    for ( v = m510_svers; v; v = v->next )
+        if ( v->sym == sym ) break;
+    if ( v == NULL )
+        return;
+    slot = ( (unsigned)(size_t)sym >> 4 ) % 64;
+    k = m510_svcnt[slot]++;
+    for ( v = m510_svers; v; v = v->next )
+        if ( v->sym == sym && v->idx == k ) {
+            sym->e.structinfo = v->si;
+            sym->sym.total_size = v->total_size;
+            sym->sym.total_length = v->total_length;
+            sym->sym.max_mbr_size = v->max_mbr_size;
+            sym->sym.mem_type = v->mem_type;
+        }
+}
