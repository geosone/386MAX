# 386LOAD.SYS, 386LOAD.COM, 386NOPT.COM and LSEG.COM (GNU make, see
# linux/mk/dos.mk)
PROJ     := 386LOAD
ROOT     := $(abspath ..)
SRCDIRS  := . ../386MAX
ASMINC   := . ../INC ../386MAX ../INCLUDE
GENERATED := LOAD_OEM.INC=LOAD@RET.OEM
PROGS    := 386LOAD.SYS 386LOAD.COM 386NOPT.COM LSEG.COM

386LOAD.SYS_OBJS := DRVLOAD.OBJ DRVCOM.OBJ LOADCOM.OBJ GETSIZE.OBJ LOADCO2.OBJ \
	DRV_MSGS.OBJ LOADMSGS.OBJ MACFNS.OBJ UTIL_NUM.OBJ UTIL_USE.OBJ UTIL_WIN.OBJ \
	VERSBETA.OBJ VERSRET.OBJ
386LOAD.SYS_MAP  := drvload.map

TSROBJS  = TSRLOAD.OBJ TSRCOM.OBJ LOADCOM.OBJ LOADCO2.OBJ GETSIZE.OBJ MACFNS.OBJ \
	TSRHIGH.OBJ TSR_MSGS.OBJ LOADMSGS.OBJ UTIL_SUM.$(1) UTIL_DDD.OBJ MAPLOAD.OBJ \
	UTIL_MA2.OBJ UTIL_MAC.OBJ UTIL_NUM.OBJ UTIL_STR.OBJ UTIL_OPT.$(1) UTIL_USE.OBJ \
	UTIL_WIN.OBJ VERSBETA.OBJ VERSRET.OBJ
386LOAD.COM_OBJS := $(call TSROBJS,OPT)
386LOAD.COM_MAP  := tsrload.map
386NOPT.COM_OBJS := $(call TSROBJS,NRM)
386NOPT.COM_MAP  := 386NOPT.map

LSEG.COM_OBJS    := LSEG.OBJ
LSEG.COM_MAP     := LSEG.map

include $(ROOT)/linux/mk/dos.mk

# configuration file read by 386MAX and 386LOAD (per program flags, e.g.
# U7 hides DPMI from HDPMI); the package takes it from build/bin
all: $(BINDIR)/386LOAD.CFG
$(BINDIR)/386LOAD.CFG: 386LOAD.CFG | $(BINDIR)
	cp $< $@
clean: cleancfg
cleancfg:
	rm -f $(BINDIR)/386LOAD.CFG
