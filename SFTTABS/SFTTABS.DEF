LIBRARY 	SFTTABS
EXETYPE 	WINDOWS
DESCRIPTION	'Tabbed Dialog Support (Open 386MAX, GPL)'
CODE		PRELOAD MOVEABLE DISCARDABLE
DATA		PRELOAD MOVEABLE SINGLE
HEAPSIZE	4096
EXPORTS
    WEP 			@1 RESIDENTNAME
    DLGTABBEDDLG_SETTEXT	@2
    DLGTABBEDDLG_GETTEXT	@3
    DLGTABBEDDLG_GETTABS	@4
    DLGTABBED_GETINSTANCEDATA=SFTTABSUNUSED	@5
    DLGTABBEDDLG_ENDDIALOG	@6
    DLGTABBED_OLDDLGPROC=SFTTABSUNUSED	@7
    DLGTABBED_FREEINSTANCEDATA=SFTTABSUNUSED	@8
    DLGTABBED_ALLOCINSTANCEDATA=SFTTABSUNUSED	@9
    DLGTABBED_ONNCDESTROYEX=SFTTABSUNUSED	@10
    ACTIVETAB_WNDPROC		@11
    DLGTABBED_ONPAINT=SFTTABSUNUSED	@12
    DLGTABBEDDLG_GETUSERDATA	@13
    DLGTABBED_ONDESTROYEX=SFTTABSUNUSED	@14
    FREELOCKEDRESOURCE=SFTTABSUNUSED	@15
    DLGTABBED_DEFPROC		@16
    DLGTABBEDDLG_SWITCHDIALOG	@17
    DLGTABBEDDEF_ONMENUCHAREX=SFTTABSUNUSED	@19
    DLGTABBED_ONINITDIALOGEX=SFTTABSUNUSED	@20
    DLGTABBED_ONERASEBKGNDEX=SFTTABSUNUSED	@21
    FINDLOADANDLOCKRESOURCE=SFTTABSUNUSED	@22
    DLGTABBEDDLG_INSIMULATEDMSG	@23
    DLGTABBEDDLG_ISTABBED	@24
    FREEALLCONTROLSENUMPROC=SFTTABSUNUSED	@25
    DLGTABBED_ONPAINTEX=SFTTABSUNUSED	@26
    DLGTABBEDDLG_DO		@27
    DLGTABBEDDEF_ONLBUTTONDOWNEX=SFTTABSUNUSED	@28
    DLGTABBEDDLG_GETENABLE	@29
    DLGTABBEDDLG_ENABLE		@30
    DLGTABBEDDLG_CREATE		@31
    DLGTABBED_ONENABLEEX=SFTTABSUNUSED	@32
    TABDLGPROC			@40
    TABSTRIPPROC		@41
