BEGIN
    CONTROL         "Voreinstellung",IDC_DEFAULT,"Button",BS_AUTORADIOBUTTON,45,
                    20,61,10
    CONTROL         "EIN",IDC_ON,"Button",BS_AUTORADIOBUTTON,130,20,23,10
    CONTROL         "AUS",IDC_OFF,"Button",BS_AUTORADIOBUTTON,190,20,25,10
    GROUPBOX        "Qualitas DOSMAX Speicher",IDC_STATIC,30,10,193,25
    LTEXT           "Diese Option schaltet die Qualitas DOSMAX-Funktion ein.",
                    IDC_HELPTEXT,10,40,235,150,NOT WS_GROUP
