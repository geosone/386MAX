/////////////////////////////////////////////////////////////////////////////
//
// String Table
//

STRINGTABLE DISCARDABLE
BEGIN
    IDS_HELPTEXT1           "Diese Option schaltet die Qualitas DOSMAX-Funktion ein. "
    IDS_HELPTEXT2           "DOSMAX erweitert den konventionellen Speicher f\374r DOS-Anwendungen von 640 KB bis zu 736 KB. "
    IDS_HELPTEXT3           "DOSMAX-Voreinstellung ist AUS (Schalter DOSMAXDefault=OFF in SYSTEM.INI Abschnitt [Qualitas]). "
    IDS_HELPTEXT4           "Mit dem Schalter in SYSTEM.INI legen Sie die Voreinstellung f\374r alle DOSMAX-Fenster fest. "
    IDS_HELPTEXT5           "\n\n"
    IDS_HELPTEXT6           "EIN schaltet DOSMAX f\374r dieses DOS-Fenster ein. "
    IDS_HELPTEXT7           "W\344hlen Sie in Eigenschaften, Registerkarte Speicher, f\374r Speicher- Einstellungen AUTOMATISCH. "
    IDS_HELPTEXT8           "So kann DOSMAX den f\374r Ihr System maximal m\366glichen Speicher bereitstellen. "
    IDS_HELPTEXT9           "AUS schaltet DOSMAX f\374r dieses DOS-Fenster aus. "
    IDS_HELPTEXT10          "\n\n"
    IDS_HELPTEXT11          "DOSMAX ist f\374r Textmodus-Anwendungen. "
    IDS_HELPTEXT12          "Der Wechsel einiger DOS-Anwendungen zwischen Text- und Grafikmodus kann zu Problemen f\374hren (Datenverlust oder Abbruch der DOS-Sitzung). "
    IDS_HELPTEXT13          "Beispiel: Word Perfect f\374r DOS ist ein Textmodus-Programm, benutzt aber z.T. den Grafikmodus (z.B. Vorschau). "
    IDS_HELPTEXT14          "DOSMAX enth\344lt die QPOPUP Warnfunktion, die den Wechsel einer DOS-Anwendung in den Grafikmodus meldet. "
    IDS_INIFILENAME         "QMAX.INI"
END

STRINGTABLE DISCARDABLE
BEGIN
    IDS_INISECTNAME         "DOSMAX - Files"
    IDS_MENUSHORTCUT        "Create DOS&MAX Shortcut"
    IDS_PSPTITLE            "DOSMAX Speicher"
    IDS_SHORTCUTTO          "Shortcut to "
    IDS_INICFGSECT          "CONFIG"
    IDS_INIMAXPATH          "Qualitas MAX Path"
    IDS_SETEWVNAME          "SETEWV.EXE"
    IDS_UNABLEFF            "Kann Datei <%s> nicht finden. DOSMAX-Funktion nicht verfügbar."
    IDS_UNABLEREG           "Kann DOSMAX16.DLL nicht registrieren. DOSMAX-Funktion nicht verfügbar."
